---
import Base from './Base.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import ArticleTOC from '../components/ArticleTOC.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { channelBySlug } from '../lib/channels';

interface Article {
  id: string;
  data: {
    title: string;
    description: string;
    pubDate: Date;
    channel: string;
    level: string;
    keywords: string[];
  };
}
interface Props {
  entry: Article;
  all: Article[];
  readingMinutes: number;
  prev: Article | null;
  next: Article | null;
}

const { entry, all, readingMinutes, prev, next } = Astro.props;
const ch = channelBySlug(entry.data.channel);
const canonical = new URL(Astro.url.pathname, Astro.site);

const articleLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.pubDate.toISOString(),
  dateModified: entry.data.pubDate.toISOString(),
  keywords: entry.data.keywords.join(','),
  author: { '@type': 'Organization', name: '汉服婚服网' },
  publisher: { '@type': 'Organization', name: '汉服婚服网', url: 'https://hanfuhunfu.com' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
  inLanguage: 'zh-CN',
});

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://hanfuhunfu.com/' },
    ch ? { '@type': 'ListItem', position: 2, name: ch.name, item: `https://hanfuhunfu.com/channels/${ch.id}/` } : null,
    { '@type': 'ListItem', position: ch ? 3 : 2, name: entry.data.title, item: canonical.href },
  ].filter(Boolean),
});
---
<Base
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  pubDate={entry.data.pubDate}
>
  <script type="application/ld+json" set:html={articleLd} />
  <script type="application/ld+json" set:html={breadcrumbLd} />

  <div class="article-layout">
    <nav class="breadcrumb" aria-label="面包屑" style="padding-top: 32px;">
      <a href="/">首页</a>
      <span class="breadcrumb__sep">/</span>
      {ch ? (
        <>
          <a href={`/channels/${ch.id}/`}>知识频道</a>
          <span class="breadcrumb__sep">/</span>
          <a href={`/channels/${ch.id}/`}>{ch.name}</a>
          <span class="breadcrumb__sep">/</span>
        </>
      ) : (
        <>
          <a href="/">知识频道</a>
          <span class="breadcrumb__sep">/</span>
        </>
      )}
      <span class="breadcrumb__current">{entry.data.title}</span>
    </nav>

    <div class="article-layout__grid">
      <article class="article-main">
        <header class="article-head">
          {ch && <a class="article-head__channel" href={`/channels/${ch.id}/`}>{ch.name}</a>}
          <h1 class="article-head__title">{entry.data.title}</h1>
          {entry.data.description && <p class="article-head__desc">{entry.data.description}</p>}
          <ArticleMeta
            channel={entry.data.channel}
            pubDate={entry.data.pubDate}
            readingMinutes={readingMinutes}
          />
        </header>

        <div class="prose">
          <slot />
        </div>

        <ArticleTOC variant="mobile" />

        {(prev || next) && (
          <nav class="prev-next" aria-label="上一篇 / 下一篇">
            {prev ? (
              <a class="prev-next__item" href={`/articles/${prev.id}/`}>
                <div class="prev-next__label">← 上一篇</div>
                <div class="prev-next__title">{prev.data.title}</div>
              </a>
            ) : <span></span>}
            {next ? (
              <a class="prev-next__item prev-next__item--next" href={`/articles/${next.id}/`}>
                <div class="prev-next__label">下一篇 →</div>
                <div class="prev-next__title">{next.data.title}</div>
              </a>
            ) : <span></span>}
          </nav>
        )}

        <RelatedArticles current={entry} all={all} />
      </article>

      <aside class="article-toc-col">
        <ArticleTOC variant="desktop" />
      </aside>
    </div>
  </div>
</Base>

<script>
  // 从 .prose 中提取 H2/H3 自动生成 TOC（桌面 + 移动共用）
  (function () {
    const prose = document.querySelector('.prose');
    if (!prose) return;
    const headings = Array.from(prose.querySelectorAll('h2, h3')) as HTMLElement[];
    if (headings.length === 0) {
      const mobile = document.getElementById('toc-mobile');
      const aside = document.querySelector('.toc');
      if (mobile) mobile.style.display = 'none';
      if (aside) aside.style.display = 'none';
      return;
    }
    headings.forEach((h, i) => { h.id = h.id || `h-${i + 1}`; });
    const html = headings.map((h) => {
      const cls = h.tagName === 'H3' ? 'toc-sub' : '';
      return `<li class="${cls}"><a href="#${h.id}">${h.textContent || ''}</a></li>`;
    }).join('');
    const target = document.getElementById('toc-list');
    const targetMobile = document.getElementById('toc-mobile-list');
    if (target) target.innerHTML = `<ul>${html}</ul>`;
    if (targetMobile) targetMobile.innerHTML = `<ul>${html}</ul>`;

    // scrollspy
    const links = Array.from(document.querySelectorAll('.toc a, .toc--mobile a')) as HTMLAnchorElement[];
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          links.forEach((a) => a.classList.remove('is-active'));
          const id = (e.target as HTMLElement).id;
          document.querySelectorAll(`.toc a[href="#${id}"], .toc--mobile a[href="#${id}"]`).forEach((a) => a.classList.add('is-active'));
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    headings.forEach((h) => observer.observe(h));
  })();
</script>

<style>
  @media (max-width: 960px) {
    .article-layout__grid {
      grid-template-columns: 1fr !important;
      gap: 0 !important;
    }
    .article-layout__grid > .article-toc-col { display: none; }
  }
</style>
