---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Container from '../../components/Container.astro';
import ArticleListItem from '../../components/ArticleListItem.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { CHANNELS } from '../../lib/channels';
import { getArticleCover } from '../../lib/cover';

export function getStaticPaths() {
  return CHANNELS.map((ch) => ({ params: { channel: ch.id } }));
}

const { channel } = Astro.params;
const ch = CHANNELS.find((c) => c.id === channel)!;

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const articles = allArticles
  .filter((a) => a.data.channel === channel)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const countByChannel = new Map<string, number>();
for (const a of allArticles) countByChannel.set(a.data.channel, (countByChannel.get(a.data.channel) ?? 0) + 1);

// 空频道推荐阅读：优先有内容频道的文章，按发布时间倒序，最多 3 篇
const recommendedArticles = allArticles
  .filter((a) => a.data.channel !== channel)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// 相关知识频道：排除当前，优先有内容，最多 4 个（2×2）
const relatedChannels = [
  ...CHANNELS.filter((c) => c.id !== channel && (countByChannel.get(c.id) ?? 0) > 0),
  ...CHANNELS.filter((c) => c.id !== channel && (countByChannel.get(c.id) ?? 0) === 0),
].slice(0, 4);

const isEmpty = articles.length === 0;

const canonical = new URL(Astro.url.pathname, Astro.site);
const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://hanfuhunfu.com/' },
    { '@type': 'ListItem', position: 2, name: ch.name, item: canonical.href },
  ],
});
---
<Base title={ch.name} description={ch.description}>
  <script type="application/ld+json" set:html={breadcrumbLd} />

  <Container>
    <nav class="breadcrumb" aria-label="面包屑" style="padding-top: 32px;">
      <a href="/">首页</a>
      <span class="breadcrumb__sep">/</span>
      <a href="/">知识频道</a>
      <span class="breadcrumb__sep">/</span>
      <span class="breadcrumb__current">{ch.name}</span>
    </nav>
  </Container>

  <header class="channel-header">
    <Container>
      <div class="channel-header__inner">
        <div class="channel-header__code">{ch.code}</div>
        <h1 class="channel-header__title">{ch.name}</h1>
        <p class="channel-header__desc">{ch.description}</p>
        {isEmpty ? (
          <div class="channel-header__count is-empty">内容正在整理</div>
        ) : (
          <div class="channel-header__count">{articles.length} 篇文章</div>
        )}
      </div>
    </Container>
  </header>

  {!isEmpty ? (
    <Container>
      <div class="channel-body">
        <ul class="article-list">
          {articles.map((a) => <ArticleListItem article={a} image={getArticleCover(a)} />)}
        </ul>
      </div>
    </Container>
  ) : (
    <>
      {recommendedArticles.length > 0 && (
        <Container>
          <section class="channel-rec">
            <header class="section-heading">
              <div>
                <h2 class="section-heading__title">你可以先读</h2>
                <span class="section-heading__subtitle">从相关主题开始了解汉服婚嫁知识。</span>
              </div>
            </header>
            <div class="channel-rec__grid">
              {recommendedArticles.map((a) => (
                <ArticleCard article={a} image={getArticleCover(a)} showExcerpt={false} />
              ))}
            </div>
          </section>
        </Container>
      )}

      <Container>
        <section class="channel-related">
          <h2 class="channel-related__title">相关知识频道</h2>
          <div class="channel-related__grid">
            {relatedChannels.map((c) => (
              <a class="channel-related__link" href={`/channels/${c.id}/`}>
                <div class="channel-related__name">{c.name}</div>
                <div class="channel-related__desc">{c.description}</div>
                <div class="channel-related__arrow">→</div>
              </a>
            ))}
          </div>
        </section>
      </Container>
    </>
  )}
</Base>
