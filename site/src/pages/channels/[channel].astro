---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CHANNELS } from '../../lib/channels';

export function getStaticPaths() {
  return CHANNELS.map((ch) => ({ params: { channel: ch.id } }));
}

const { channel } = Astro.params;
const ch = CHANNELS.find((c) => c.id === channel)!;
const articles = (await getCollection('articles', ({ data }) => data.channel === channel && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title={`${ch.name} - 汉服婚服网`} description={ch.description}>
  <nav class="breadcrumb"><a href="/">首页</a> / {ch.name}</nav>
  <h1 style="font-size:24px;margin:0 0 6px;">{ch.name}</h1>
  <p style="color:var(--muted);font-size:14px;">{ch.description}</p>
  <ul class="article-list">
    {articles.map((a) => (
      <li>
        <a class="title" href={`/articles/${a.id}/`}>{a.data.title}</a>
        <div class="meta"><span class="badge">{a.data.level} 级</span>{a.data.description}</div>
      </li>
    ))}
  </ul>
  {articles.length === 0 && <p style="color:var(--muted);">本频道内容生成中，敬请期待。</p>}
</Base>
